= render(Invitation::Layout::PageComponent.new) do
  .relative.h-full.flex.flex-col.items-center.justify-center.px-6.py-8.gap-6.text-gray-500
    - options = { class: "w-full font-ambrosia text-6xl text-gray-500 text-center" }
    .flex.flex-col.items-center.justify-center.mt-10
      %h1{ options } Alberto
      %h1{ options.merge(style: "font-size: 36px") } &
      %h1{ options } Andrea

    .space-y-5
      %h2.w-full.uppercase{ class: "w-[85%] text-[10px] tracking-[.15em]" }= t(".invitation_title_html")

      .flex.flex-row.items-center.justify-start
        %p.uppercase.text-center.leading-3.mr-6.pr-6.border-r.border-gray-200
          %span.text-xs= invitation.wedding.date.strftime("%b")
          %br
          %span.text-2xl{ class: "tracking-[.05em]" }= invitation.wedding.date.strftime("%d")
          %br
          %span.text-sm= invitation.wedding.date.strftime("%Y")
        %p.uppercase.leading-4{ class: "text-[10px] tracking-[.15em]" }
          %span.text-gray-700= t(".ceremony")
          %br
          %span Hotel Oro Verde
          %br
          %span= t(".location")
          %p.uppercase.leading-4{ class: "text-[10px] tracking-[.1em]" }

      %p.uppercase.leading-4{ class: "text-center text-[10px] tracking-[.15em] flex flex-row justify-center" }
        %span{ class: "text-[10px] mb-2!" } Si quieres tener un detalle con nosotros, puedes hacer una transferencia a:

      %div.uppercase.leading-4{ class: "text-center text-bold text-[12px] tracking-[.15em] flex flex-col justify-center gap-1" }
        %p Banco Pichincha
        %p Cuenta Corriente: 2100175111
        %p Alexandra Castillo